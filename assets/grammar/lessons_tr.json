  {
   "id": "tr_present_continuous",
   "category": "tr_verbs",
   "level": "A1",
   "title_tr": "Şimdiki zaman: -iyor",
   "title_en": "Present continuous: -iyor",
   "explanation": "**-iyor** says what is happening now, and often what you do regularly.\n- Take the verb stem (drop -mek/-mak): gel**mek** → gel. Add **-iyor** (four-way: -ıyor, -iyor, -uyor, -üyor): geliyorum.\n- A stem ending in a vowel drops it: bekle → bekl**iyor**, ara → ar**ıyor**.\n- Endings: -um, -sun, (nothing), -uz, -sunuz, -lar: geliyorum, geliyorsun, geliyor, geliyoruz, geliyorsunuz, geliyorlar.\n- Negative: **-m-** before -iyor: gelmiyorum.",
   "structure": [
    "verb stem + -(ı/i/u/ü)yor + personal ending",
    "verb stem + -m(ı/i/u/ü)yor (negative)"
   ],
   "examples": [
    [
     "Şu an kitap okuyorum.",
     "I'm reading a book right now."
    ],
    [
     "Ne yapıyorsun?",
     "What are you doing?"
    ],
    [
     "Yağmur yağıyor.",
     "It's raining."
    ]
   ],
   "exercises": [
    {
     "id": "tr_present_continuous-1",
     "tr": "I'm coming.",
     "answers": [
      "Geliyorum."
     ],
     "note": "gel + -iyor + -um."
    },
    {
     "id": "tr_present_continuous-2",
     "tr": "What are you doing?",
     "answers": [
      "Ne yapıyorsun?",
      "Ne yapıyorsunuz?"
     ],
     "note": "yap + -ıyor + -sun."
    },
    {
     "id": "tr_present_continuous-3",
     "tr": "It's raining.",
     "answers": [
      "Yağmur yağıyor."
     ],
     "note": "yağ + -ıyor."
    },
    {
     "id": "tr_present_continuous-4",
     "tr": "We're waiting for you.",
     "answers": [
      "Seni bekliyoruz.",
      "Sizi bekliyoruz."
     ],
     "note": "bekle drops its e: bekliyoruz."
    },
    {
     "id": "tr_present_continuous-5",
     "tr": "I don't understand.",
     "answers": [
      "Anlamıyorum."
     ],
     "note": "anla + -m- + -ıyor + -um."
    },
    {
     "id": "tr_present_continuous-6",
     "tr": "She is working at home.",
     "answers": [
      "Evde çalışıyor.",
      "O evde çalışıyor."
     ],
     "note": "çalış + -ıyor."
    }
   ]
