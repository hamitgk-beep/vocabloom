     ],
     "note": "Names take an apostrophe: Londra'dan."
    },
    {
     "id": "tr_locative_ablative-4",
     "tr": "in the street",
     "answers": [
      "sokakta"
     ],
     "note": "After k the d becomes t: sokakta."
    },
    {
     "id": "tr_locative_ablative-5",
     "tr": "I'm at work.",
     "answers": [
      "İşteyim.",
      "Ben işteyim."
     ],
     "note": "iş + -te (after ş) + -yim."
