  {
   "id": "tr_questions_mi",
   "category": "tr_sentence",
   "level": "A1",
   "title_tr": "Soru eki: mı, mi, mu, mü",
   "title_en": "Yes/no questions with mi",
   "explanation": "**A yes/no question takes the little word mi** after the word you ask about.\n- It is written separately but follows vowel harmony: **mı, mi, mu, mü**.\n- Personal endings go on it: Yorgun **musun**? (Are you tired?) Hazır **mıyız**? (Are we ready?)\n- Put it after the word in focus: **Sen mi** geldin? (Was it you who came?) / Sen **geldin mi**? (Did you come?)\n- Question words (ne, nerede, kim) do not take mi.",
   "structure": [
    "statement + mı / mi / mu / mü?",
    "adjective + mı + personal ending (musun, mıyım…)"
   ],
   "examples": [
    [
     "Çay ister misin?",
     "Would you like tea?"
    ],
    [
     "Bu senin kitabın mı?",
     "Is this your book?"
    ],
    [
     "Hazır mısınız?",
     "Are you ready?"
    ]
   ],
   "exercises": [
    {
     "id": "tr_questions_mi-1",
     "tr": "Is it cold?",
     "answers": [
      "Soğuk mu?",
      "Hava soğuk mu?"
     ],
     "note": "soğuk → mu (last vowel u)."
    },
    {
     "id": "tr_questions_mi-2",
