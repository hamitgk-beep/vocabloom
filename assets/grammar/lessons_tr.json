     ],
     "note": "var mı? asks if something exists."
    },
    {
     "id": "tr_var_yok-6",
     "tr": "Do you have a car?",
     "answers": [
      "Araban var mı?",
      "Arabanız var mı?",
      "Senin araban var mı?"
     ],
     "note": "araba + -n (your) + var mı?"
    }
   ]
