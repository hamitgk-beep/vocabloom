 "topics": [
  {
   "id": "tr_vowel_harmony",
   "category": "tr_sounds",
   "level": "A1",
   "title_tr": "Ünlü uyumu ve çoğul eki",
   "title_en": "Vowel harmony and the plural",
   "explanation": "**Turkish words take endings, and the endings change their vowel to match the word.**\n- Back vowels: **a, ı, o, u**. Front vowels: **e, i, ö, ü**.\n- The plural ending is **-ler** after a front vowel and **-lar** after a back vowel: ev → evler, kitap → kitaplar.\n- The last vowel of the word decides: öğrenci → öğrenciler, kapı → kapılar.\n- After a number, the noun stays singular: iki kitap (two books), not *iki kitaplar*.",
   "structure": [
    "word + -ler (last vowel e, i, ö, ü)",
    "word + -lar (last vowel a, ı, o, u)",
    "number + singular noun"
   ],
   "examples": [
    [
     "Evler büyük.",
     "The houses are big."
    ],
    [
     "Çocuklar bahçede.",
     "The children are in the garden."
    ],
    [
     "Üç elma aldım.",
     "I bought three apples."
    ]
   ],
   "exercises": [
    {
     "id": "tr_vowel_harmony-1",
     "tr": "the books",
     "answers": [
      "kitaplar"
     ],
     "note": "kitap ends in a back vowel (a): -lar."
    },
    {
     "id": "tr_vowel_harmony-2",
     "tr": "the houses",
     "answers": [
      "evler"
     ],
     "note": "ev has a front vowel (e): -ler."
    },
    {
     "id": "tr_vowel_harmony-3",
     "tr": "the students",
     "answers": [
      "öğrenciler"
     ],
     "note": "The last vowel of öğrenci is i (front): -ler."
    },
    {
     "id": "tr_vowel_harmony-4",
     "tr": "the doors",
     "answers": [
      "kapılar"
     ],
     "note": "The last vowel of kapı is ı (back): -lar."
    },
    {
     "id": "tr_vowel_harmony-5",
     "tr": "two cats",
     "answers": [
      "iki kedi"
     ],
     "note": "After a number the noun stays singular."
    },
    {
     "id": "tr_vowel_harmony-6",
     "tr": "The children are happy.",
     "answers": [
      "Çocuklar mutlu.",
      "Çocuklar mutlular."
     ],
     "note": "çocuk → çocuklar (u is a back vowel)."
    }
   ]
  },
  {
   "id": "tr_to_be",
   "category": "tr_sounds",
   "level": "A1",
   "title_tr": "Ek fiil: -(y)im, -sin, -dir",
   "title_en": "To be: personal endings",
   "explanation": "**Turkish has no separate word for \"am, is, are\". An ending on the noun or adjective does the job.**\n- ben → **-(y)Im**, sen → **-sIn**, o → (nothing or -dIr), biz → **-(y)Iz**, siz → **-sInIz**, onlar → **-lAr**.\n- The vowel follows four-way harmony: ı, i, u, ü. Öğretmenim (I am a teacher), yorgunum (I am tired).\n- After a vowel, a **y** joins the ending: hastayım, öğrenciyiz.\n- The pronoun is usually left out, because the ending already says who.",
   "structure": [
    "noun/adjective + -(y)ım / -(y)im / -(y)um / -(y)üm (I am)",
    "noun/adjective + -sın / -sin / -sun / -sün (you are)",
    "noun/adjective + -(y)ız … (we are)"
   ],
   "examples": [
    [
     "Öğretmenim.",
     "I am a teacher."
    ],
    [
     "Yorgun musun?",
     "Are you tired?"
    ],
    [
     "Biz Türk değiliz, İngiliziz.",
     "We aren't Turkish, we are English."
    ]
   ],
   "exercises": [
    {
     "id": "tr_to_be-1",
     "tr": "I am tired.",
     "answers": [
      "Yorgunum."
     ],
     "note": "yorgun + -um (last vowel u)."
    },
    {
     "id": "tr_to_be-2",
     "tr": "You are a student.",
     "answers": [
      "Öğrencisin."
     ],
     "note": "öğrenci + -sin."
    },
    {
     "id": "tr_to_be-3",
     "tr": "We are happy.",
     "answers": [
      "Mutluyuz."
     ],
     "note": "mutlu ends in a vowel: y + -uz."
    },
    {
     "id": "tr_to_be-4",
     "tr": "I am a doctor.",
     "answers": [
      "Doktorum."
     ],
     "note": "doktor + -um."
    },
    {
     "id": "tr_to_be-5",
     "tr": "You are very kind.",
     "answers": [
      "Çok naziksin.",
      "Çok naziksiniz."
     ],
     "note": "nazik + -sin (or -siniz to be polite)."
    },
    {
     "id": "tr_to_be-6",
     "tr": "They are at home.",
     "answers": [
      "Evdeler.",
      "Onlar evde."
     ],
     "note": "ev + -de (at) + -ler (they)."
    }
   ]
  },
  {
   "id": "tr_var_yok",
   "category": "tr_sentence",
   "level": "A1",
   "title_tr": "Var / yok",
   "title_en": "There is / there isn't: var and yok",
   "explanation": "**var** means \"there is / exists\", **yok** means \"there isn't\".\n- Masada bir kitap var. = There is a book on the table.\n- To say \"I have\", use the possessive: **Benim bir kardeşim var.** (literally: my sibling exists).\n- Questions: **var mı?** / **yok mu?** — Çay var mı? (Is there any tea?)",
   "structure": [
    "place + -de/-da + thing + var/yok",
    "(benim) + noun + possessive ending + var/yok",
    "... var mı?"
   ],
   "examples": [
    [
     "Burada bir market var.",
     "There is a supermarket here."
    ],
    [
     "Arabam yok.",
     "I don't have a car."
    ],
    [
     "Sorunuz var mı?",
     "Do you have a question?"
    ]
   ],
   "exercises": [
    {
     "id": "tr_var_yok-1",
     "tr": "There is a cat in the garden.",
     "answers": [
      "Bahçede bir kedi var.",
      "Bahçede kedi var."
     ],
     "note": "place-de + thing + var."
    },
    {
     "id": "tr_var_yok-2",
     "tr": "There isn't any milk.",
     "answers": [
      "Süt yok."
     ],
     "note": "yok = there is not."
    },
    {
     "id": "tr_var_yok-3",
     "tr": "I have a brother.",
     "answers": [
      "Bir erkek kardeşim var.",
      "Bir kardeşim var.",
      "Erkek kardeşim var.",
      "Kardeşim var.",
      "Benim bir erkek kardeşim var.",
      "Benim bir kardeşim var."
     ],
     "note": "kardeş + -im (my) + var."
    },
    {
     "id": "tr_var_yok-4",
     "tr": "I don't have time.",
     "answers": [
      "Zamanım yok.",
      "Vaktim yok."
     ],
     "note": "zaman + -ım (my) + yok."
    },
    {
     "id": "tr_var_yok-5",
     "tr": "Is there a bank near here?",
     "answers": [
      "Yakında banka var mı?",
      "Buralarda banka var mı?",
      "Yakında bir banka var mı?",
